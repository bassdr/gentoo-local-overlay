# Wrapper for /opt/kilo/kilo (dev-util/kilo-cli-bin).
# kilo is managed by Portage: disable its self-update machinery and
# intercept self-management commands with a Gentoo-appropriate message.

# Kill the in-TUI update banner; inherited by everything kilo spawns.
KILO_DISABLE_AUTOUPDATE=1
export KILO_DISABLE_AUTOUPDATE

case "$1" in
	upgrade|uninstall)
		echo "kilo is managed by Portage (dev-util/kilo-cli-bin): '$1' is disabled." >&2
		echo "Update with: emerge --sync bassdr && emerge -u dev-util/kilo-cli-bin" >&2
		exit 1
		;;
esac

exec /opt/kilo/kilo "$@"
